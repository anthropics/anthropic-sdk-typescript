{
  "extends": "./tsconfig.json",
  "include": ["dist/src"],
  "exclude": ["dist/src/internal/detect-platform.ts", "dist/src/internal/message-stream-utils.ts"],
  "compilerOptions": {
    "rootDir": "./dist/src",
    "paths": {
      "@anthropic-ai/sdk/*": ["../../dist-internal/*"],
      "@anthropic-ai/sdk": ["../../dist-internal/index.d.ts"],
      "@anthropic-ai/bedrock-sdk/*": ["./src/*"],
      "@anthropic-ai/bedrock-sdk": ["./src/index.ts"]
    },
    "noEmit": false,
    "declaration": true,
    "stripInternal": true,
    "declarationMap": true,
    "outDir": "dist",
    "pretty": true,
    "sourceMap": true
  }
}
