{
  "include": ["src", "shared"],
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // rollup and webpack bundle this output; esbuild and vite take src/main.ts directly
    "rootDir": ".",
    "outDir": "dist/tsc",
    "skipLibCheck": false
  }
}
