{
  "include": ["src", "shared", "env.d.ts"],
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "webworker"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
